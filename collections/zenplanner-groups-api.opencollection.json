{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zen Planner Classes Groups API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.partners.daxko.com/v3/partners/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Groups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.partners.daxko.com/api/v1/groups"
          },
          "docs": "Retrieve a page of groups and the people associated with them (for example households or family memberships)."
        }
      ]
    }
  ],
  "bundled": true
}