{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zen Planner Classes Memberships API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.partners.daxko.com/v3/partners/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Memberships",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve memberships for a person",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.partners.daxko.com/api/v1/people/:personId/memberships",
            "params": [
              {
                "name": "personId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve the list of memberships held by a person."
        }
      ]
    }
  ],
  "bundled": true
}