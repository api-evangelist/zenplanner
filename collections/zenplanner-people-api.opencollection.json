{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zen Planner Classes People API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.partners.daxko.com/v3/partners/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "People",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve people",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.partners.daxko.com/api/v1/people"
          },
          "docs": "Retrieve a page of people (members and contacts) for the account."
        },
        {
          "info": {
            "name": "Retrieve a person",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.partners.daxko.com/api/v1/people/:personId",
            "params": [
              {
                "name": "personId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a single person by id."
        }
      ]
    }
  ],
  "bundled": true
}